# Public example only. Copy to .env.runtime under restrictive permissions.
# Do not put the initial admin password in the runtime env or version control.
OC_URL=https://drive.goreecloud.com
OC_CONFIG_DIR=/etc/opencloud
OC_BASE_DATA_PATH=/var/lib/opencloud
PROXY_HTTP_ADDR=0.0.0.0:9200
PROXY_TLS=false
OC_INSECURE=false
IDM_CREATE_DEMO_USERS=false
PROXY_ENABLE_BASIC_AUTH=false
OC_SHARING_PUBLIC_SHARE_MUST_HAVE_PASSWORD=true
OC_SHARING_PUBLIC_WRITEABLE_SHARE_MUST_HAVE_PASSWORD=true
OC_PASSWORD_POLICY_DISABLED=false
OC_PASSWORD_POLICY_MIN_CHARACTERS=12
